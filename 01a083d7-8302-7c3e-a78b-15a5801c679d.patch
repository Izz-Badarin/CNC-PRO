++        b.doors.forEach(d=>{
++          const target = this.doorFrac;
++          d.cur += (target - d.cur) * 0.5;
++          if (d.mode==='swing') d.node.rotation.y = d.base + d.sign * d.cur * OPEN_ANGLE;
