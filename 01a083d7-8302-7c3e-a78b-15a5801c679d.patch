+          </div>
+        </div>
+      </div>
+
+      <div className="mt-4 flex gap-2 flex-wrap">
+        <Btn size="sm" onClick={() => { setInfo(storageInfo()); setBacks(listBackups(SETTINGS_VERSION)); }}><HardDrive size={12} /> Refresh</Btn>
+        <Btn size="sm" variant="danger" onClick={() => {
