{
  "name": "CNC Cabinet Designer Pro",
  "short_name": "Cabinets",
  "description": "CNC cabinet design, cut lists, nesting, drilling and DXF export — 100% offline, plane mode ready, no internet needed.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "window-controls-overlay", "minimal-ui", "browser"],
  "orientation": "any",
  "background_color": "#070b12",
  "theme_color": "#070b12",
  "lang": "en",
  "categories": ["productivity", "utilities", "business"],
  "launch_handler": { "client_mode": ["navigate-existing", "auto"] },
  "handle_links": "preferred",
  "edge_side_panel": { "preferred_width": 480 },
  "icons": [
    {
      "src": "./icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    },
    {
      "src": "./icon.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./icon.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    { "name": "New Project", "url": "./", "description": "Start a new cabinet project offline" },
    { "name": "3D View", "url": "./#3d", "description": "Open 3D preview" }
  ],
  "screenshots": []
}
